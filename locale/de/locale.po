msgid "plugins.generic.webhook.displayName"
msgstr "Veröffentlichungs-Webhook"

msgid "plugins.generic.webhook.description"
msgstr "Sendet bei Veröffentlichung einer Einreichung einen HTTP-Webhook mit den Artikel-Metadaten."

msgid "plugins.generic.webhook.description.requiresConfig"
msgstr "Bitte richten Sie in den Plugin-Einstellungen eine Webhook-URL ein, bevor Sie dieses Plugin aktivieren."

msgid "plugins.generic.webhook.description.doiConfigWarning"
msgstr "Die DOI-Einstellungen dieser Zeitschrift entsprechen nicht dem, was die Gegenstelle erwartet (DOIs für Publikationen aktiviert, manuell vergeben, nie automatisch erzeugt) - die von dort zurückgemeldete DOI wird möglicherweise nicht korrekt übernommen."

msgid "plugins.generic.webhook.settings.webhookUrl"
msgstr "Webhook-URL"

msgid "plugins.generic.webhook.settings.webhookUrl.description"
msgstr "Die URL, an die bei Übergabe in die Herstellung oder Veröffentlichung einer Einreichung ein HTTP-POST-Request mit den Artikel-Metadaten gesendet wird. Bei einem Zeitschriftenserver (MyCoRe) enthält sie dessen eigene Zeitschriften-ID, z. B. https://example.org/rsc/ojs/jportal_jpjournal_00002373."

msgid "plugins.generic.webhook.settings.webhookUrl.invalid"
msgstr "Bitte geben Sie eine gültige Webhook-URL ein."

msgid "plugins.generic.webhook.settings.webhookSecret"
msgstr "Webhook-Secret (optional)"

msgid "plugins.generic.webhook.settings.webhookSecret.description"
msgstr "Falls gesetzt, wird jeder Request mit diesem Wert signiert (HMAC-SHA256 über den Request-Body) und im Header X-Webhook-Signature mitgesendet, damit die Gegenstelle prüfen kann, dass die Anfrage von dieser Zeitschrift stammt und unverändert ist. Das Secret selbst wird nie übertragen."

msgid "plugins.generic.webhook.settings.requireDoiBeforePublish"
msgstr "Veröffentlichen erst zulassen, wenn für die Einreichung eine DOI hinterlegt ist (z. B. aus einer vorherigen Webhook-Antwort)."

msgid "plugins.generic.webhook.validatePublish.missingDoi"
msgstr "Diese Einreichung kann noch nicht veröffentlicht werden, da noch keine DOI dafür hinterlegt ist."

msgid "plugins.generic.webhook.linkAction.resend"
msgstr "Webhook erneut senden"

msgid "plugins.generic.webhook.resend.submissionId"
msgstr "Einreichungs-ID"

msgid "plugins.generic.webhook.resend.submissionId.description"
msgstr "Die ID der Einreichung (aus ihrer URL), für die der Webhook erneut gesendet werden soll. Verwendet das zuletzt gesendete Ereignis (production/published/updated/unpublished), bzw. \"updated\", falls noch nie gesendet wurde."

msgid "plugins.generic.webhook.resend.notFound"
msgstr "In dieser Zeitschrift wurde keine Einreichung mit dieser ID gefunden."

msgid "plugins.generic.webhook.resend.queued"
msgstr "Der Webhook wurde zum erneuten Senden eingereiht."

msgid "plugins.generic.webhook.resend.notConfigured"
msgstr "Für diese Zeitschrift ist keine gültige Webhook-URL konfiguriert, es wurde daher nichts gesendet. Bitte zuerst in den Plugin-Einstellungen eine URL hinterlegen."

msgid "plugins.generic.webhook.status.label"
msgstr "Webhook-Status"

msgid "plugins.generic.webhook.status.sent"
msgstr "Erfolgreich gesendet ({$event}) am {$date}."

msgid "plugins.generic.webhook.status.failed"
msgstr "Senden fehlgeschlagen ({$event}) am {$date}."

msgid "plugins.generic.webhook.status.zsId"
msgstr "Zeitschriftenserver-ID: {$id}"

msgid "plugins.generic.webhook.status.warnings"
msgstr "Warnungen:"

msgid "plugins.generic.webhook.status.warning"
msgstr "- {$label}: {$detail}"

msgid "plugins.generic.webhook.status.warning.noDetail"
msgstr "- {$label}"

msgid "plugins.generic.webhook.status.error"
msgstr "Fehler: {$error}"

msgid "plugins.generic.webhook.warning.noIssue"
msgstr "Der Artikel ist noch keiner Ausgabe zugeordnet."

msgid "plugins.generic.webhook.warning.ambiguousTitle"
msgstr "Mehrere Artikel der Ausgabe tragen diesen Titel; der erste wurde aktualisiert."

msgid "plugins.generic.webhook.warning.unknownRubric"
msgstr "Für diese Sektion wurde im Zeitschriftenserver keine passende Rubrik gefunden."

msgid "plugins.generic.webhook.warning.noPersons"
msgstr "Dem Artikel ist noch keine Person zugeordnet; DataCite benötigt mindestens eine Autorin/einen Autor."

msgid "plugins.generic.webhook.warning.unlinkedAuthors"
msgstr "Autor/innen ohne verwendbare ORCID (fehlt, ungültig oder einer anderen Person gehörend) wurden nicht verknüpft."

msgid "plugins.generic.webhook.warning.invalidOrcid"
msgstr "Eine ORCID ist ungültig (falsches Format oder falsche Prüfziffer)."

msgid "plugins.generic.webhook.warning.foreignOrcid"
msgstr "Eine unbestätigte ORCID gehört einer Person mit anderem Namen; die Autorin/der Autor wurde nicht verknüpft."

msgid "plugins.generic.webhook.warning.unverifiedOrcid"
msgstr "Eine Autorin/ein Autor wurde über eine ORCID verknüpft, die über ORCID noch nicht bestätigt wurde."

msgid "plugins.generic.webhook.warning.noPages"
msgstr "Für diesen Artikel ist kein Seitenbereich angegeben."

msgid "plugins.generic.webhook.warning.doiDisabled"
msgstr "Für diese Zeitschrift ist im Zeitschriftenserver kein DOI-Dienst konfiguriert."

msgid "plugins.generic.webhook.warning.doiFailed"
msgstr "Der DOI-Dienst konnte keine DOI vergeben."

msgid "plugins.generic.webhook.warning.doiMismatch"
msgstr "OJS und der Zeitschriftenserver haben für diesen Artikel unterschiedliche DOIs hinterlegt."

msgid "plugins.generic.webhook.warning.unknownSubmission"
msgstr "Zu dieser Einreichung gibt es im Zeitschriftenserver keinen Artikel."

msgid "plugins.generic.webhook.warning.unpublishedInOjs"
msgstr "Diese Einreichung wurde in OJS zurückgezogen; der Artikel und seine DOI bleiben im Zeitschriftenserver bestehen."
