msgid "plugins.generic.webhook.displayName"
msgstr "Veröffentlichungs-Webhook"

msgid "plugins.generic.webhook.description"
msgstr "Sendet bei Veröffentlichung einer Einreichung einen HTTP-Webhook mit den Artikel-Metadaten."

msgid "plugins.generic.webhook.description.requiresConfig"
msgstr "Bitte richten Sie in den Plugin-Einstellungen eine Webhook-URL ein, bevor Sie dieses Plugin aktivieren."

msgid "plugins.generic.webhook.settings.webhookUrl"
msgstr "Webhook-URL"

msgid "plugins.generic.webhook.settings.webhookUrl.description"
msgstr "Die URL, an die bei jeder Veröffentlichung einer Einreichung ein HTTP-POST-Request mit den Artikel-Metadaten gesendet wird."

msgid "plugins.generic.webhook.settings.webhookUrl.invalid"
msgstr "Bitte geben Sie eine gültige Webhook-URL ein."

msgid "plugins.generic.webhook.settings.webhookSecret"
msgstr "Webhook-Secret (optional)"

msgid "plugins.generic.webhook.settings.webhookSecret.description"
msgstr "Falls gesetzt, wird dieser Wert bei jedem Request im Header X-Webhook-Secret mitgesendet, damit die Gegenstelle prüfen kann, dass die Anfrage von dieser Zeitschrift stammt."
