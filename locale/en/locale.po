msgid "plugins.generic.webhook.displayName"
msgstr "Webhook Notifier"

msgid "plugins.generic.webhook.description"
msgstr "Sends an HTTP webhook with the article's metadata whenever a submission is published."

msgid "plugins.generic.webhook.description.requiresConfig"
msgstr "Configure a webhook URL in the plugin settings before this plugin can be enabled."

msgid "plugins.generic.webhook.description.doiConfigWarning"
msgstr "This journal's DOI settings do not match what the receiving endpoint expects (DOIs enabled for publications, assigned manually, never auto-generated) - the DOI it returns may not be recorded correctly."

msgid "plugins.generic.webhook.settings.webhookUrl"
msgstr "Webhook URL"

msgid "plugins.generic.webhook.settings.webhookUrl.description"
msgstr "The URL that will receive an HTTP POST request with the article's metadata whenever a submission is sent to production or published. For a Zeitschriftenserver (MyCoRe) endpoint, this includes that journal's own journal ID, e.g. https://example.org/rsc/ojs/jportal_jpjournal_00002373."

msgid "plugins.generic.webhook.settings.webhookUrl.invalid"
msgstr "Please enter a valid webhook URL."

msgid "plugins.generic.webhook.settings.webhookSecret"
msgstr "Webhook secret (optional)"

msgid "plugins.generic.webhook.settings.webhookSecret.description"
msgstr "If set, each request is signed with this value (HMAC-SHA256 over the request body) in the X-Webhook-Signature header, so the receiving endpoint can verify the request came from this journal and was not tampered with. The secret itself is never sent."

msgid "plugins.generic.webhook.settings.requireDoiBeforePublish"
msgstr "Do not allow publishing a submission until a DOI has been recorded for it (e.g. from a prior webhook response)."

msgid "plugins.generic.webhook.validatePublish.missingDoi"
msgstr "This submission cannot be published yet because no DOI has been recorded for it."

msgid "plugins.generic.webhook.linkAction.resend"
msgstr "Resend webhook"

msgid "plugins.generic.webhook.resend.submissionId"
msgstr "Submission ID"

msgid "plugins.generic.webhook.resend.submissionId.description"
msgstr "The ID of the submission (as shown in its URL) to resend the webhook for. Uses whatever event was last sent for it (production/published/updated/unpublished), or \"updated\" if it was never sent before."

msgid "plugins.generic.webhook.resend.notFound"
msgstr "No submission with this ID was found in this journal."

msgid "plugins.generic.webhook.resend.queued"
msgstr "The webhook has been queued for resending."

msgid "plugins.generic.webhook.resend.notConfigured"
msgstr "No valid webhook URL is configured for this journal, so nothing was sent. Configure one in the plugin settings first."

msgid "plugins.generic.webhook.status.label"
msgstr "Webhook status"

msgid "plugins.generic.webhook.status.sent"
msgstr "Successfully sent ({$event}) on {$date}."

msgid "plugins.generic.webhook.status.failed"
msgstr "Failed to send ({$event}) on {$date}."

msgid "plugins.generic.webhook.status.zsId"
msgstr "Zeitschriftenserver ID: {$id}"

msgid "plugins.generic.webhook.status.warnings"
msgstr "Warnings:"

msgid "plugins.generic.webhook.status.warning"
msgstr "- {$label}: {$detail}"

msgid "plugins.generic.webhook.status.warning.noDetail"
msgstr "- {$label}"

msgid "plugins.generic.webhook.status.error"
msgstr "Error: {$error}"

msgid "plugins.generic.webhook.warning.noIssue"
msgstr "The article is not yet assigned to an issue."

msgid "plugins.generic.webhook.warning.ambiguousTitle"
msgstr "Several articles in the issue share this title; the first one was updated."

msgid "plugins.generic.webhook.warning.unknownRubric"
msgstr "No matching rubric was found for this section in the Zeitschriftenserver."

msgid "plugins.generic.webhook.warning.noPersons"
msgstr "No person is linked to the article yet; DataCite requires at least one creator."

msgid "plugins.generic.webhook.warning.unlinkedAuthors"
msgstr "Authors without a usable ORCID iD (missing, invalid or belonging to someone else) were not linked."

msgid "plugins.generic.webhook.warning.invalidOrcid"
msgstr "An ORCID iD is malformed (wrong format or check digit)."

msgid "plugins.generic.webhook.warning.foreignOrcid"
msgstr "An unverified ORCID iD belongs to a person of another name; the author was not linked."

msgid "plugins.generic.webhook.warning.unverifiedOrcid"
msgstr "An author was linked by an ORCID iD they have not confirmed via ORCID."

msgid "plugins.generic.webhook.warning.noPages"
msgstr "No page range is set for this article."

msgid "plugins.generic.webhook.warning.doiDisabled"
msgstr "No DOI service is configured for this journal in the Zeitschriftenserver."

msgid "plugins.generic.webhook.warning.doiFailed"
msgstr "The DOI service was unable to mint a DOI."

msgid "plugins.generic.webhook.warning.doiMismatch"
msgstr "OJS and the Zeitschriftenserver have different DOIs on file for this article."

msgid "plugins.generic.webhook.warning.unknownSubmission"
msgstr "No article exists for this submission in the Zeitschriftenserver."

msgid "plugins.generic.webhook.warning.unpublishedInOjs"
msgstr "This submission was withdrawn in OJS; the article and its DOI remain in the Zeitschriftenserver."
