msgid "plugins.generic.webhook.displayName"
msgstr "Webhook Notifier"

msgid "plugins.generic.webhook.description"
msgstr "Sends an HTTP webhook with the article's metadata whenever a submission is published."

msgid "plugins.generic.webhook.description.requiresConfig"
msgstr "Configure a webhook URL in the plugin settings before this plugin can be enabled."

msgid "plugins.generic.webhook.settings.webhookUrl"
msgstr "Webhook URL"

msgid "plugins.generic.webhook.settings.webhookUrl.description"
msgstr "The URL that will receive an HTTP POST request with the article's metadata whenever a submission is published."

msgid "plugins.generic.webhook.settings.webhookUrl.invalid"
msgstr "Please enter a valid webhook URL."

msgid "plugins.generic.webhook.settings.webhookSecret"
msgstr "Webhook secret (optional)"

msgid "plugins.generic.webhook.settings.webhookSecret.description"
msgstr "If set, this value is sent with each request in the X-Webhook-Secret header so the receiving endpoint can verify the request came from this journal."
